import { useEffect, useRef, useState } from "react";

const CHARS =
  "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()_+~|}{[]:;?><";

interface Props {
  text: string;
  delay?: number;
  triggered: boolean;
}

/**
 * Entrance reveal: after `delay` ms, characters resolve left-to-right
 * at 0.5 chars per frame, 25ms per frame. Unresolved characters within
 * 3 positions of the cursor show random glyphs; beyond that, nothing.
 */
export default function ScrambleIn({ text, delay = 0, triggered }: Props) {
  const [output, setOutput] = useState("");
  const [started, setStarted] = useState(false);
  const frame = useRef(0);
  const interval = useRef<ReturnType<typeof setInterval> | null>(null);

  useEffect(() => {
    if (!triggered) return;
    const t = setTimeout(() => setStarted(true), delay);
    return () => clearTimeout(t);
  }, [triggered, delay]);

  useEffect(() => {
    if (!started) return;

    frame.current = 0;
    interval.current = setInterval(() => {
      const revealed = frame.current * 0.5;

      const next = text
        .split("")
        .map((ch, i) => {
          if (ch === " ") return " ";
          if (i < revealed) return ch;
          if (i < revealed + 3)
            return CHARS[Math.floor(Math.random() * CHARS.length)];
          return "";
        })
        .join("");

      setOutput(next);

      if (revealed >= text.length) {
        setOutput(text);
        if (interval.current) clearInterval(interval.current);
      }
      frame.current += 1;
    }, 25);

    return () => {
      if (interval.current) clearInterval(interval.current);
    };
  }, [started, text]);

  if (!triggered) return <>&nbsp;</>;
  return <>{output || "\u00A0"}</>;
}

import { useEffect, useRef, useState } from "react";

const CHARS =
  "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()_+~|}{[]:;?><";

interface Props {
  text: string;
  isHovered: boolean;
  className?: string;
}

/**
 * Hover-driven scramble: all characters randomize, then resolve
 * left-to-right at 4 frames per character, 25ms per frame.
 * Unhovering resets instantly.
 */
export default function ScrambleText({ text, isHovered, className }: Props) {
  const [output, setOutput] = useState(text);
  const frame = useRef(0);
  const interval = useRef<ReturnType<typeof setInterval> | null>(null);

  useEffect(() => {
    if (interval.current) clearInterval(interval.current);

    if (!isHovered) {
      setOutput(text);
      return;
    }

    frame.current = 0;
    interval.current = setInterval(() => {
      const revealed = frame.current / 4;

      const next = text
        .split("")
        .map((ch, i) => {
          if (ch === " ") return " ";
          if (i < revealed) return ch;
          return CHARS[Math.floor(Math.random() * CHARS.length)];
        })
        .join("");

      setOutput(next);

      if (revealed >= text.length) {
        setOutput(text);
        if (interval.current) clearInterval(interval.current);
      }
      frame.current += 1;
    }, 25);

    return () => {
      if (interval.current) clearInterval(interval.current);
    };
  }, [isHovered, text]);

  return <span className={className}>{output}</span>;
}

import { motion } from "framer-motion";

interface Props {
  open: boolean;
  mobile?: boolean;
}

const SPRING = { type: "spring" as const, stiffness: 300, damping: 20 };

export default function SquashHamburger({ open, mobile = false }: Props) {
  const w = mobile ? 15 : 18;
  const h = mobile ? 10 : 12;
  const bar = mobile ? 1.2 : 1.5;
  const mid = h / 2 - bar / 2;

  return (
    <div className="relative" style={{ width: w, height: h }}>
      <motion.span
        className="absolute left-0 bg-white rounded-full"
        style={{ width: w, height: bar, top: 0 }}
        animate={open ? { top: mid, rotate: 45 } : { top: 0, rotate: 0 }}
        transition={SPRING}
      />
      <motion.span
        className="absolute left-0 bg-white rounded-full"
        style={{ width: w, height: bar, top: mid }}
        animate={open ? { opacity: 0, scaleX: 0 } : { opacity: 1, scaleX: 1 }}
        transition={SPRING}
      />
      <motion.span
        className="absolute left-0 bg-white rounded-full"
        style={{ width: w, height: bar, top: h - bar }}
        animate={open ? { top: mid, rotate: -45 } : { top: h - bar, rotate: 0 }}
        transition={SPRING}
      />
    </div>
  );
}

