import { useEffect, useRef } from "react";
import { motion } from "framer-motion";
import ScrambleIn from "../components/ScrambleIn";
import { VIDEOS } from "../videos";

const SENSITIVITY = 0.8;

interface Props {
  entranceComplete: boolean;
}

export default function Hero({ entranceComplete }: Props) {
  const video = useRef<HTMLVideoElement>(null);
  const target = useRef(0);
  const seeking = useRef(false);

  /* Mouse-scrub: horizontal movement scrubs the timeline.
     Seeks are chained through the `seeked` event so frames are not dropped. */
  useEffect(() => {
    const v = video.current;
    if (!v) return;

    const step = () => {
      if (seeking.current) return;
      const clamped = Math.max(0, Math.min(target.current, v.duration || 0));
      if (Math.abs(clamped - v.currentTime) < 0.001) return;
      seeking.current = true;
      v.currentTime = clamped;
    };

    const onSeeked = () => {
      seeking.current = false;
      step();
    };

    const onMove = (e: MouseEvent) => {
      if (!v.duration) return;
      const delta = (e.movementX / window.innerWidth) * v.duration * SENSITIVITY;
      target.current = Math.max(0, Math.min(target.current + delta, v.duration));
      step();
    };

    const onMeta = () => {
      v.pause();
      v.currentTime = 0;
      target.current = 0;
    };

    v.addEventListener("loadedmetadata", onMeta);
    v.addEventListener("seeked", onSeeked);
    window.addEventListener("mousemove", onMove);
    return () => {
      v.removeEventListener("loadedmetadata", onMeta);
      v.removeEventListener("seeked", onSeeked);
      window.removeEventListener("mousemove", onMove);
    };
  }, []);

  return (
    <section className="relative w-full h-screen h-[100dvh] overflow-hidden">
      <video
        ref={video}
        src={VIDEOS.hero}
