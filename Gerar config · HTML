<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Gerador do config.js — Cérebro Rico</title>
<style>
:root{--bg:#0d0d0f;--bg2:#151518;--bg3:#1c1c21;--linha:#2a2a31;
--txt:#ece9e4;--txt2:#9b968e;--txt3:#6b675f;--acento:#d99a2b;--ok:#5f9c6a;--alerta:#c4622d}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--txt);font-family:Inter,-apple-system,"Segoe UI",sans-serif;
font-size:16px;line-height:1.6;padding:34px 20px 70px}
.wrap{max-width:640px;margin:0 auto}
h1{font-size:26px;font-weight:700;letter-spacing:-.02em;margin-bottom:6px}
.sub{color:var(--txt2);font-size:15px;margin-bottom:28px}
.passo{background:var(--bg2);border:1px solid var(--linha);border-radius:13px;padding:20px;margin-bottom:16px}
.n{display:inline-flex;width:24px;height:24px;border-radius:50%;background:var(--bg3);color:var(--acento);
font-size:13px;font-weight:700;align-items:center;justify-content:center;margin-right:9px}
h2{font-size:17px;font-weight:600;display:flex;align-items:center;margin-bottom:6px}
.dica{font-size:13.5px;color:var(--txt3);margin-bottom:14px;line-height:1.55}
label{display:block;font-size:13px;color:var(--txt2);margin:14px 0 7px}
input{width:100%;padding:13px 15px;border-radius:10px;background:var(--bg);border:1px solid var(--linha);
color:var(--txt);font:inherit;font-size:14px;font-family:ui-monospace,Menlo,Consolas,monospace}
input:focus{outline:none;border-color:var(--acento)}
button{width:100%;padding:16px;border:none;border-radius:11px;background:var(--acento);color:#1a1206;
font:inherit;font-size:16px;font-weight:600;cursor:pointer;margin-top:18px}
button:disabled{background:var(--bg3);color:var(--txt3);cursor:default}
.msg{margin-top:14px;font-size:14px;padding:12px 15px;border-radius:10px;display:none;line-height:1.5}
.msg.erro{display:block;background:rgba(196,98,45,.12);border:1px solid rgba(196,98,45,.35);color:#e8a882}
.msg.bom{display:block;background:rgba(95,156,106,.12);border:1px solid rgba(95,156,106,.35);color:#8fc79a}
pre{background:var(--bg);border:1px solid var(--linha);border-radius:9px;padding:14px;overflow-x:auto;
font-size:12.5px;color:#d8d4cd;margin-top:14px;font-family:ui-monospace,Menlo,Consolas,monospace}
.nota{border-left:3px solid var(--acento);background:rgba(217,154,43,.06);padding:13px 16px;
border-radius:0 8px 8px 0;font-size:14px;color:#d8d4cd;margin-top:22px;line-height:1.6}
code{background:var(--bg3);padding:2px 6px;border-radius:5px;font-size:13px}
</style>
</head>
<body>
<div class="wrap">

  <h1>Gerador do config.js</h1>
  <p class="sub">Cole os dois valores do Supabase e baixe o arquivo pronto. Nada é enviado para lugar nenhum — tudo acontece dentro deste navegador.</p>

  <div class="passo">
    <h2><span class="n">1</span>Pegue os valores no Supabase</h2>
    <div class="dica">No painel do Supabase, vá em <b>Settings → API</b>. Copie o <b>Project URL</b> e a chave <b>anon public</b> (a enorme, que começa com <code>eyJ</code>).</div>

    <label for="url">Project URL</label>
    <input id="url" placeholder="https://abcdefghijk.supabase.co" spellcheck="false" autocomplete="off">

    <label for="key">anon public</label>
    <input id="key" placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." spellcheck="false" autocomplete="off">
  </div>

  <div class="passo">
    <h2><span class="n">2</span>Baixe o arquivo</h2>
    <div class="dica">O arquivo sai com o nome exato <code>config.js</code>. Ele vai para a sua pasta de downloads.</div>
    <button id="btn" disabled>Baixar config.js</button>
    <div class="msg" id="msg"></div>
    <pre id="previa" style="display:none"></pre>
  </div>

  <div class="passo">
    <h2><span class="n">3</span>Suba para a HostGator</h2>
    <div class="dica">
      No cPanel → Gerenciador de Arquivos → pasta <code>public_html/app</code> → <b>Carregar</b> → envie o <code>config.js</code> baixado.<br><br>
      Ele vai substituir o arquivo vazio que veio no zip. O cPanel pergunta se quer sobrescrever — confirme.<br><br>
      Você não precisa editar nada. Só subir.
    </div>
  </div>

  <div class="nota">
    A chave <b>anon</b> é pública por natureza: ela vai para o navegador de todo comprador e não tem como escondê-la. Quem protege seus dados são as políticas de segurança do banco, não essa chave.<br><br>
    A que <b>nunca</b> pode aparecer aqui é a <b>service_role</b>. Se você colar ela por engano, este gerador avisa e recusa.
  </div>

</div>

<script>
const url = document.getElementById("url");
const key = document.getElementById("key");
const btn = document.getElementById("btn");
const msg = document.getElementById("msg");
const previa = document.getElementById("previa");

function aviso(texto, tipo) {
  msg.className = "msg " + (tipo || "");
  msg.innerHTML = texto || "";
  if (!texto) msg.style.display = "none";
}

/* Lê o miolo do JWT para saber se é anon ou service_role.
   Isso roda só aqui, no seu navegador. */
function papelDaChave(k) {
  try {
    const meio = k.split(".")[1];
    const dados = JSON.parse(atob(meio.replace(/-/g, "+").replace(/_/g, "/")));
    return dados.role || null;
  } catch (e) { return null; }
}

function validar() {
  const u = url.value.trim();
  const k = key.value.trim();
  aviso("");

  if (!u && !k) { btn.disabled = true; previa.style.display = "none"; return; }

  if (u && !/^https:\/\/[a-z0-9-]+\.supabase\.co\/?$/i.test(u)) {
    aviso("A Project URL parece incompleta. Ela tem o formato <code>https://algumacoisa.supabase.co</code>, sem barra no fim e sem nada depois.", "erro");
    btn.disabled = true; return;
  }

  if (k) {
    const papel = papelDaChave(k);
    if (papel === "service_role") {
      aviso("<b>Essa é a chave service_role.</b> Ela ignora todas as regras de segurança e não pode ir para o navegador. Volte em Settings → API e copie a chave <b>anon public</b>.", "erro");
      btn.disabled = true; return;
    }
    if (k.length < 40 || !k.startsWith("ey")) {
      aviso("A chave parece incompleta. Ela é bem longa e começa com <code>eyJ</code>. Copie o valor inteiro.", "erro");
      btn.disabled = true; return;
    }
  }

  const pronto = !!u && !!k;
  btn.disabled = !pronto;
  if (pronto) {
    aviso("Os dois valores estão com cara de certos. Pode baixar.", "bom");
    previa.style.display = "block";
    previa.textContent = gerar();
  } else {
    previa.style.display = "none";
  }
}

function gerar() {
  const u = url.value.trim().replace(/\/$/, "");
  const k = key.value.trim();
  return `/* ============================================================
   CÉREBRO RICO — CONFIGURAÇÃO
   Gerado em ${new Date().toLocaleDateString("pt-BR")}.

   Este arquivo conecta o app e o painel ao Supabase.
   Para trocar os valores, gere o arquivo de novo pelo
   gerar-config.html e suba por cima deste.
   ============================================================ */

window.CEREBRO_RICO = {

  SUPABASE_URL: "${u}",

  SUPABASE_ANON_KEY: "${k}"

};
`;
}

btn.onclick = () => {
  const blob = new Blob([gerar()], { type: "text/javascript;charset=utf-8" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "config.js";
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  aviso("Arquivo baixado. Agora suba ele para a pasta <code>public_html/app</code> no cPanel, substituindo o que está lá.", "bom");
};

url.addEventListener("input", validar);
key.addEventListener("input", validar);
</script>
</body>
</html>
